# Copy to .env and fill in. Never commit .env.

# Supabase (project region must be in the EU)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# service role: only for the CLI/worker on the operator's machine, never in the browser
SUPABASE_SERVICE_ROLE_KEY=
# used by the web app (public)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection for migrations / SQL checks (local or Supabase pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres

# Anthropic
ANTHROPIC_API_KEY=

# Server-side secrets for pseudonymisation and field encryption (32 random bytes, base64)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IBAN_HMAC_KEY=
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=1

# Pipeline versions (bump deliberately; every run row records them)
PIPELINE_VERSION=1

# Client certificate for the certificate-gated registry checks (AEAT VNifV2 identity check of a
# vendor's NIF and name). Operator machine only; never in hosted functions. Path to the PKCS#12
# (.p12 / .pfx) file of the operator's or the community's qualified certificate, and its
# passphrase. The file stays outside the repository and the passphrase is never logged; when the
# variables are unset the check raises its manual web-form route instead.
VX_CLIENT_CERT_P12=
VX_CLIENT_CERT_PASSPHRASE=
