data/
originals/
derived/
exports/
seed/local/
*.n43
*.q43
*.tsr

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test artefacts
playwright-report/
test-results/

# client certificates for registry lookups (operator machine only)
*.p12
*.pfx
