# Copy to apps/web/.env.local (never committed). The browser only ever sees the anon key;
# row-level security decides what it may read or write.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pipeline version used in job idempotency keys (<sha256>:ingest:<version>). Keep in step with
# PIPELINE_VERSION used by the worker.
NEXT_PUBLIC_PIPELINE_VERSION=1
