# Public build-time configuration for the hosted app. Nothing here is secret: the project URL
# and the publishable (anon) key are shipped to every browser in the JS bundle, and row-level
# security decides what a signed-in user may read or write. Secrets never go in this file;
# the worker's service-role key and database password live only in the untracked root .env.
NEXT_PUBLIC_SUPABASE_URL=https://rfjulnhozroglglrittw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SoEirz_G6sh-7EIGhO8ACw_jyvVEKKF
NEXT_PUBLIC_PIPELINE_VERSION=1
